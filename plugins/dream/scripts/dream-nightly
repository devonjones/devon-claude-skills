#!/usr/bin/env bash
# Nightly box pass: distill the last day's sessions, then wake this box's
# dreams tab (a herdr Claude, default dreams-<hostname>) to mine and deliver
# the lessons. Run by the dream-nightly systemd user timer.
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
TAB="${DREAM_TAB:-dreams-$(hostname -s | tr '[:upper:]' '[:lower:]')}"
DAYS="${DREAM_DAYS:-1}"

"$HERE/dream" box --days "$DAYS"
BOX="$(ls -t "$HOME"/.dream/box/*-box.json | head -1)"

pane="$(herdr agent list | jq -r --arg t "$TAB" \
  '.result.agents[] | select(.terminal_title_stripped == $t) | .pane_id' | head -1)"
if [ -z "$pane" ]; then
  echo "dream-nightly: no herdr tab named $TAB; $BOX is ready for a manual pass" >&2
  exit 1
fi

out="$(herdr agent prompt "$pane" "Nightly dream pass: $BOX is fresh (dream box --days $DAYS already ran). Do your standing lesson pass on it: dedup, file dream beads, message owners, and report to mission-control.")"
echo "$out"
# herdr reports errors in JSON with exit 0, so check the body.
! grep -q '"error"' <<<"$out"
