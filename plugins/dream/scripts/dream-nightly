#!/usr/bin/env bash
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
DAYS="${DREAM_DAYS:-1}"

"$HERE/dream" box --days "$DAYS"
BOX="$HOME/.dream/box/$(date +%Y%m%d)-box.json"
if [ ! -f "$BOX" ]; then
  echo "dream-nightly: dream box wrote no $BOX" >&2
  exit 1
fi

cd "$HERE/../../.."
exec "${CLAUDE:-claude}" -p "Nightly dream pass: $BOX is fresh (dream box --days $DAYS already ran). Read $HERE/../references/box-pass.md in full and follow it on that file." --permission-mode auto
